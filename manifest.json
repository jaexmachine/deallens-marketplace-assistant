{
  "manifest_version": 3,
  "name": "DealLens – Marketplace Deal Assistant",
  "short_name": "DealLens",
  "version": "0.1.0",
  "description": "Locally analyze visible Marketplace listings for price trends, flip potential, and risk signals.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "storage", "sidePanel", "tabs"],
  "host_permissions": ["https://www.facebook.com/marketplace/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open DealLens",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["src/scoring.js", "src/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
