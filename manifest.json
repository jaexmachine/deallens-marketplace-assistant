{
  "manifest_version": 3,
  "name": "Deal Breaker – Facebook Marketplace Deal Finder",
  "short_name": "Deal Breaker",
  "version": "0.7.1",
  "description": "Analyze visible Facebook Marketplace listings for price trends, realistic margins, condition, and risk signals.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "storage", "sidePanel", "tabs", "scripting"],
  "host_permissions": [
    "https://facebook.com/marketplace/*",
    "https://*.facebook.com/marketplace/*"
  ],
  "optional_host_permissions": ["https://generativelanguage.googleapis.com/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Open Deal Breaker",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://facebook.com/marketplace/*",
        "https://*.facebook.com/marketplace/*"
      ],
      "js": ["src/scoring.js", "src/description-extractor.js", "src/scan-coordinator.js", "src/content.js"],
      "css": ["styles/content.css"],
      "run_at": "document_idle"
    }
  ]
}
